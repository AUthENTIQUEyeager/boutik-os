generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Boutique {
  id          String   @id @default(uuid())
  nom         String
  whatsapp    String   @unique
  password    String
  adresse     String?
  logo        String?  @db.Text
  siteWeb     String?
  bloquee     Boolean  @default(false)
  devise      String   @default("FCFA")
  fuseauHoraire String @default("Africa/Ouagadougou")
  abonnementDebut DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories  Categorie[]
  produits    Produit[]
  ventes      Vente[]
  clients     Client[]
  salaries    Salarie[]
  commandes   Commande[]
  depenses    Depense[]
  dettes      Dette[]
}

model Categorie {
  id          String   @id
  boutiqueId  String
  boutique    Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  nom         String
  prefix      String
  prixAchat   Int
  prixVente   Int
  quantite    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  produits    Produit[]
  ventes      Vente[]

  @@index([boutiqueId])
  @@index([boutiqueId, updatedAt])
}

model Produit {
  id          String   @id
  boutiqueId  String
  boutique    Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  nom         String
  prixAchat   Int
  prixVente   Int
  vendu       Boolean  @default(false)
  dateVente   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vente       Vente?

  @@index([boutiqueId])
  @@index([boutiqueId, updatedAt])
  @@index([categorieId])
}

model Vente {
  id          String   @id
  boutiqueId  String
  boutique    Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  produitId   String?  @unique
  produit     Produit? @relation(fields: [produitId], references: [id])
  categorieId String?
  categorie   Categorie? @relation(fields: [categorieId], references: [id])
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  salarieId   String?
  salarie     Salarie? @relation(fields: [salarieId], references: [id])
  nomProduit  String
  prixVente   Int
  prixAchat   Int
  benefice    Int
  vendeurNom  String   @default("Gérant")
  type        String   @default("normal")
  date        DateTime @default(now())
  recu        Boolean  @default(false)
  numeroRecu  String?
  createdAt   DateTime @default(now())

  @@index([boutiqueId])
  @@index([boutiqueId, date])
  @@index([boutiqueId, createdAt])
}

model Client {
  id          String   @id @default(uuid())
  boutiqueId  String
  boutique    Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  nom         String
  telephone   String?
  email       String?
  adresse     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ventes      Vente[]
  dettes      Dette[]

  @@index([boutiqueId])
  @@index([boutiqueId, updatedAt])
}

model Salarie {
  id          String   @id @default(uuid())
  boutiqueId  String
  boutique    Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  nom         String
  poste       String?
  telephone   String?
  salaire     Int      @default(0)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ventes      Vente[]

  @@index([boutiqueId])
  @@index([boutiqueId, updatedAt])
}

model Commande {
  id          String   @id @default(uuid())
  boutiqueId  String
  boutique    Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  fournisseur String?
  statut      String   @default("en_attente")
  total       Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lignes      LigneCommande[]

  @@index([boutiqueId])
  @@index([boutiqueId, updatedAt])
}

model LigneCommande {
  id           String   @id @default(uuid())
  commandeId   String
  commande     Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  nomProduit   String
  quantite     Int
  prixUnitaire Int
}

model Depense {
  id          String   @id @default(uuid())
  boutiqueId  String
  boutique    Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  montant     Int
  categorie   String
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([boutiqueId])
  @@index([boutiqueId, date])
  @@index([boutiqueId, updatedAt])
}

model Dette {
  id           String   @id @default(uuid())
  boutiqueId   String
  boutique     Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  nomClient    String
  telephone    String?
  montantTotal Int
  montantPaye  Int      @default(0)
  solde        Int
  statut       String   @default("en_cours")
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  paiements    PaiementDette[]

  @@index([boutiqueId])
  @@index([boutiqueId, updatedAt])
}

model PaiementDette {
  id       String   @id @default(uuid())
  detteId  String
  dette    Dette    @relation(fields: [detteId], references: [id], onDelete: Cascade)
  montant  Int
  date     DateTime @default(now())
}

model PwaInstall {
  id          Int      @id @default(autoincrement())
  platform    String   @default("unknown")
  installedAt DateTime @default(now())
  userAgent   String   @default("")
}

model PwaVisit {
  id          Int      @id @default(autoincrement())
  platform    String   @default("unknown")
  isInstalled Boolean  @default(false)
  visitedAt   DateTime @default(now())
}
